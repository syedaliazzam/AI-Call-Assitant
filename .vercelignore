# File: .vercelignore
# Purpose: Files the Vercel CLI must NOT upload when running `vercel deploy` from the repo root.
#          Vercel already skips node_modules, .git, .next, .vercel, .env.local and .env.*.local
#          by default; this adds the rest.

# Every environment file (they may hold secrets), except the names-only example.
# Variables reach Vercel builds through `vercel env`, never through uploaded files.
.env*
**/.env*
!apps/web/.env.example

# Planning documents, diagrams and the .docx copy are not needed to build or run the app.
docs

# Local test and build output.
coverage
**/*.tsbuildinfo

# Speech-to-text model files and test recordings (development copies, ~205 MB; over the 100 MB
# Hobby upload limit). Production loads model files from Hugging Face (ADR-0020).
# public/stt-runtime is NOT listed: the build fetches it anyway, and an uploaded verified copy
# just lets the build skip the download.
apps/web/public/models

# The developer's voice recordings for the speech engine trial (Day 6) are never uploaded.
apps/web/tests/fixtures/stt/names-audio/
