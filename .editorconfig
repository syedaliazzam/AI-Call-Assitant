# File: .editorconfig
# Purpose: Basic editor settings (indentation, line endings) so every editor matches Prettier.
# See https://editorconfig.org

root = true

[*]
charset = utf-8
# LF everywhere, also on Windows (matches .gitattributes and .prettierrc).
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in Markdown, so keep them.
trim_trailing_whitespace = false
