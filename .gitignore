# File: .gitignore
# Purpose: Keep dependencies, build output, secrets and downloaded model files out of git.

# Dependencies
node_modules/

# Build output and caches
.next/
dist/
out/
*.tsbuildinfo
coverage/
# Playwright (desktop smoke test) results and HTML report
test-results/
playwright-report/

# Vercel CLI link data (created by `vercel link`)
.vercel/

# Environment files hold secrets and are never committed (CLAUDE.md "Secrets never go in code").
# .env.example lists variable names only, so it is kept. In .gitignore the LAST matching rule
# wins, so no `.env*` line may be added below this point (`vercel link` appends one; delete it).
.env*
!.env.example

# Generated by Next.js on every dev/build/typegen run.
apps/web/next-env.d.ts

# Speech-to-text files are downloaded by `pnpm --filter web fetch-models`, never committed:
# the model and test recordings (development only) and the runtime (also fetched by every build).
apps/web/public/models/**
apps/web/public/stt-runtime/**
apps/web/public/punct/**
apps/web/public/turn/**
# 1.5.2 (ADR-0070): the echo canceller, copied from npm by fetch-models.ts
apps/web/public/aec/**

# Evaluation results: per-scenario scores and grader reasons, kept on the developer's machine
apps/web/eval-results/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# v1.4 (ADR-0062): real call transcripts and recordings kept for testing never enter git.
docs/testing/calls/

# Day 6 names set: the developer's voice stays out of git (the manifest with SHA-256 is committed)
apps/web/tests/fixtures/stt/names-audio/

# Day 6 Stage 3: Windows installers built by electron-builder
apps/desktop/release/

# v1.0.1: the accurate-transcription native runtime, staged by apps/desktop/scripts/stage-native.mjs
apps/desktop/native/

# 1.8.0 (ADR-0109): the Mac signing certificate's private key never enters the repository, in any form;
# only the public certificate.pem is committed. The bridge signing rule is written at build time.
*.p12
*.pfx
*.key
key.pem
apps/desktop/build/mac-signing/requirements.txt

# v1.1.0: copies of another company's screens, for side-by-side checks only. Never committed;
# docs/design/reference-catalog.md describes them in words.
docs/design/references/
docs/testing/v1.2-visual/
