# File: .gitignore
# Purpose: Keep dependencies, build output, secrets and downloaded model files out of git.

# Dependencies
node_modules/

# Build output and caches
.next/
dist/
out/
*.tsbuildinfo
coverage/

# Vercel CLI link data (created by `vercel link`)
.vercel/

# Environment files hold secrets and are never committed (CLAUDE.md "Secrets never go in code").
# .env.example lists variable names only, so it is kept.
.env*
!.env.example

# Generated by Next.js on every dev/build/typegen run.
apps/web/next-env.d.ts

# Speech-to-text model files are downloaded by `pnpm --filter web fetch-models`, not committed.
apps/web/public/models/**

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
