# File: .gitignore
# Purpose: Keep dependencies, build output, secrets and downloaded model files out of git.

# Dependencies
node_modules/

# Build output and caches
.next/
dist/
out/
*.tsbuildinfo
coverage/
# Playwright (desktop smoke test) results and HTML report
test-results/
playwright-report/

# Vercel CLI link data (created by `vercel link`)
.vercel/

# Environment files hold secrets and are never committed (CLAUDE.md "Secrets never go in code").
# .env.example lists variable names only, so it is kept. In .gitignore the LAST matching rule
# wins, so no `.env*` line may be added below this point (`vercel link` appends one; delete it).
.env*
!.env.example

# Generated by Next.js on every dev/build/typegen run.
apps/web/next-env.d.ts

# Speech-to-text files are downloaded by `pnpm --filter web fetch-models`, never committed:
# the model and test recordings (development only) and the runtime (also fetched by every build).
apps/web/public/models/**
apps/web/public/stt-runtime/**

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# Day 6 names set: the developer's voice stays out of git (the manifest with SHA-256 is committed)
apps/web/tests/fixtures/stt/names-audio/

# Day 6 Stage 3: Windows installers built by electron-builder
apps/desktop/release/
