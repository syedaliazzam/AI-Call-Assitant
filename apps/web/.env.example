# File: apps/web/.env.example
# Purpose: Names of the environment variables the web app needs. Names only, never values.
#          Real values live in Vercel. Add one with `vercel env add NAME`, then download them
#          into apps/web/.env.local with `vercel env pull apps/web/.env.local`.
# Read by: src/server/env.ts (validation), scripts/lib/require-key.ts, drizzle.config.ts,
#          scripts/create-admin.ts, src/server/google/config.ts (ADR-0072)

# --- Accounts database and sign-in (Day 1 Stage 2) ---

# Neon Postgres connection string. Added automatically when the Neon database is connected
# to the Vercel project (Storage tab).
DATABASE_URL=

# Random secret (at least 32 characters) that Better Auth uses to sign session cookies.
# Generate one with: npx auth@latest secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Public address of the app, used for sign-in cookies and CSRF checks.
# Development: http://localhost:3000. Production: the custom domain (ADR-0046).
# Leave unset on preview deployments: the app then uses https://$VERCEL_URL.
BETTER_AUTH_URL=

# Every address production is opened from, comma-separated: the custom domain and the vercel.app
# address that installed desktop apps are locked to. Leave unset everywhere else (ADR-0046).
KITE_TRUSTED_ORIGINS=

# Brandfetch client ID, for company suggestions and logos (ADR-0048). It reaches the browser, as
# Brandfetch's APIs require, and is not a secret. Unset: suggestions come from past sessions only.
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=

# --- Claude (Day 1 Stage 3) ---

# Claude API key. Server only; never sent to the browser or logged.
# One key for everything (CLAUDE.md "Claude key and spend"): the deployed app, `pnpm dev`,
# scripts/verify-*.ts and the evaluations, under one Console spend limit. The scripts refuse to
# run without it; each paid run is agreed, with its estimated cost, first.
ANTHROPIC_API_KEY=

# Model for live answers, for example claude-haiku-5-5.
KITE_MODEL_FAST=

# Model for notes and other slower, higher-quality output, for example claude-sonnet-5-5.
KITE_MODEL_SMART=

# --- Groq, the third answer model "Fastest (Groq)" (ADR-0095) ---
# Server-only key; without it Groq is off and Groq sessions answer with Claude Haiku.
GROQ_API_KEY=
# Groq model id; optional (default openai/gpt-oss-120b).
GROQ_MODEL=

# --- Call data in the account (ADR-0049) ---

# Data key for synced call data: 32 random bytes, base64. Set in Production with
# `vercel env add KITE_DATA_KEY_V1 production`, and keep a copy in the company password manager:
# losing it makes the data it encrypted unreadable. A later key is KITE_DATA_KEY_V2, and so on.
# Never put a value here.
KITE_DATA_KEY_V1=

# --- Cloud speech-to-text (ADR-0076) ---

# Deepgram API key (a dedicated key with the Member role, so it can mint short-lived tokens). Server only:
# never sent to a browser or logged; browsers get 60-second tokens from POST /api/stt/token.
DEEPGRAM_API_KEY=

# Optional. The Deepgram host for tokens and sockets (default api.eu.deepgram.com; api.deepgram.com for the US).
DEEPGRAM_HOST=

# Optional. The model per channel: the other side (default flux-general-en) and the microphone (default nova-3).
DEEPGRAM_MODEL_THEM=
DEEPGRAM_MODEL_YOU=

# The cloud transcription rollout: comma-separated account ids that use Deepgram (and the newest-question
# rules), or * for everyone. Unset: nobody (the on-device engine, as before).
# `pnpm --filter web sync-user-ids --email you@company.com` prints an account's id in your terminal.
KITE_STT_DEEPGRAM_USERS=

# --- Google Drive saving and the "saved" email (ADR-0072; docs/deploy/google-drive.md) ---

# The Google OAuth client (type: Web application) and its secret. Server only. Unset: Settings says
# "Google Drive is not set up". Switching to another Google project changes only these four values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The Google Picker API key (restricted to the Picker API and Kite's addresses). Sent only to
# signed-in people, through GET /api/google/picker-config.
GOOGLE_PICKER_API_KEY=

# The Google Cloud project NUMBER (Picker's setAppId), so a picked folder is shared with Kite.
NEXT_PUBLIC_GOOGLE_APP_ID=

# SMTP, for the "saved to Google Drive" email (sent with nodemailer). Server only. Until all five are
# set: no email, and Settings says "Email not set up"; uploads still work. SMTP_PORT 465 = TLS from the
# start, 587 = STARTTLS (required). SMTP_PASS is an app password, never logged. NOTIFY_FROM_EMAIL is
# the sender, normally the SMTP_USER mailbox: Paramount AI <notify@paramountintelligence.co>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM_EMAIL=

# Vercel's daily job (vercel.json "crons") that sends "saved" emails which waited 24 hours for a recording
# upload (ADR-0072). Vercel sends it as a Bearer token; at least 16 characters. Unset: the job does
# nothing, and such emails go the next time the person's app talks to the server.
CRON_SECRET=
