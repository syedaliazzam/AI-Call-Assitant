{
  "name": "@kite/web",
  "version": "0.0.0",
  "private": true,
  "description": "Kite web application (Next.js): all screens, browser logic and the server routes. Deployed to Vercel.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm run stt:runtime && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "create-admin": "tsx --env-file=.env.local --conditions=react-server scripts/create-admin.ts",
    "create-e2e-user": "tsx --env-file=.env.local --conditions=react-server scripts/create-e2e-user.ts",
    "verify:warm": "tsx --env-file=.env.local --conditions=react-server scripts/verify-warm.ts",
    "verify:answer-cache": "tsx --env-file=.env.local --conditions=react-server scripts/verify-answer-cache.ts",
    "verify:screenshot": "tsx --env-file=.env.local --conditions=react-server scripts/verify-screenshot.ts",
    "verify:notes": "tsx --env-file=.env.local --conditions=react-server scripts/verify-notes.ts",
    "verify:setup": "tsx --env-file=.env.local --conditions=react-server scripts/verify-setup.ts",
    "eval:notes": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/eval-notes.ts",
    "eval:answers": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/eval-answers.ts",
    "eval:all": "tsx scripts/eval-all.ts",
    "visual:rig": "tsx tests/visual/overlay-rig.ts",
    "check:answer-shape": "tsx --env-file=.env.local --conditions=react-server scripts/check-answer-shape.ts",
    "record:streams": "tsx --env-file=.env.local --conditions=react-server scripts/record-answer-streams.ts",
    "e2e-admin": "tsx --env-file=.env.local --conditions=react-server scripts/e2e-admin.ts",
    "rotate-e2e-password": "tsx --env-file=.env.local --conditions=react-server scripts/rotate-e2e-password.ts",
    "sync-user-ids": "tsx --env-file=.env.local --conditions=react-server scripts/sync-user-ids.ts",
    "fetch-models": "tsx scripts/fetch-models.ts",
    "make-brand": "tsx scripts/make-brand.ts",
    "make-guide": "tsx scripts/make-guide.ts",
    "stt:runtime": "tsx scripts/fetch-models.ts --runtime-only && tsx scripts/check-stt-runtime.ts",
    "stt:record-names": "tsx scripts/record-names.ts",
    "stt:trial": "tsx scripts/stt-trial.ts",
    "calls:make": "tsx scripts/make-calls.ts",
    "stt:calls": "tsx scripts/stt-calls.ts",
    "test:stt": "playwright test -c tests/integration/playwright.config.ts stt.spec.ts",
    "test:sim-calls": "playwright test -c tests/integration/playwright.config.ts sim-calls.spec.ts",
    "test:db-upgrade": "playwright test -c tests/integration/playwright.config.ts db-upgrade.spec.ts",
    "test:punctuation": "playwright test -c tests/integration/playwright.config.ts punctuation.spec.ts",
    "test:answers": "playwright test -c tests/integration/playwright.config.ts answers.spec.ts",
    "test:screenshot": "playwright test -c tests/integration/playwright.config.ts screenshot.spec.ts",
    "test:review": "playwright test -c tests/integration/playwright.config.ts review.spec.ts",
    "test:live-ui": "playwright test -c tests/integration/playwright.config.ts live.spec.ts",
    "test:setup": "playwright test -c tests/integration/playwright.config.ts setup.spec.ts",
    "test:prepare": "playwright test -c tests/integration/playwright.config.ts prepare.spec.ts",
    "test:ask-kite": "playwright test -c tests/integration/playwright.config.ts ask-kite.spec.ts",
    "test:ui-kit": "playwright test -c tests/integration/playwright.config.ts ui-kit.spec.ts",
    "test:shell": "playwright test -c tests/integration/playwright.config.ts shell.spec.ts",
    "test:handoff": "playwright test -c tests/integration/playwright.config.ts handoff.spec.ts",
    "test:launcher": "playwright test -c tests/integration/playwright.config.ts launcher.spec.ts",
    "test:screens": "playwright test -c tests/integration/playwright.config.ts screens.spec.ts",
    "test:ui-shots": "playwright test -c tests/ui/playwright.config.ts",
    "test:e2e-prod": "pnpm --filter @kite/desktop build && playwright test -c tests/e2e-prod/playwright.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@kite/shared": "workspace:*",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.13",
    "dexie": "4.4.6",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.61.0",
    "mammoth": "1.13.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "pyodide": "314.0.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
