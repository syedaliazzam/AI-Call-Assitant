{
  "name": "@kite/web",
  "version": "0.0.0",
  "private": true,
  "description": "Kite web application (Next.js): all screens, browser logic and the server routes. Deployed to Vercel.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm run stt:runtime && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "create-admin": "tsx --env-file=.env.local --conditions=react-server scripts/create-admin.ts",
    "fetch-models": "tsx scripts/fetch-models.ts",
    "stt:runtime": "tsx scripts/fetch-models.ts --runtime-only && tsx scripts/check-stt-runtime.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@kite/shared": "workspace:*",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.13",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
