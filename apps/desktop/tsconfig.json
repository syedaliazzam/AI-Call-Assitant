/**
 * File: apps/desktop/tsconfig.json
 * Purpose: Type-check settings for the Electron shell (main process, preload, tests).
 *          esbuild produces the real output (dist/); TypeScript only checks types.
 * Depends on: ../../tsconfig.base.json; Electron's own type definitions (electron package)
 */
{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The preload and the smoke test touch `window` and DOM types.
    "lib": ["ES2023", "DOM"],
    // Node types for the main process (TypeScript 6 no longer loads @types automatically).
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts", "*.config.mts"]
}
